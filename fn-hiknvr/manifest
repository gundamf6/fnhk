appname               = fn-hiknvr
version               = 0.2.3
display_name          = 飞海监控
desc                  = 在 fnOS 上搭建类似群晖 Surveillance Station 的监控管理套件：面向海康威视摄像头的本地 NVR——实时预览、连续+事件双轨录像、网页回放、本地移动侦测。<br>只读拉取 RTSP（绝不修改摄像头设置），支持多台摄像机与自定义录像目录，数据仅保存在本机。
source                = thirdparty
platform              = x86
maintainer            = DP
distributor           = DP
os_min_version        = 1.2.0
desktop_uidir         = ui
desktop_applaunchname = fn-hiknvr.main
ctl_stop              = true
checkport             = false
service_port          = 8091
changelog             = 0.2.3：发布前安全加固——日志脱敏（不再出现摄像头密码）、配置文件权限收紧、网关/本机鉴权收紧、录像清理与孤儿进程判据更精确、磁盘写满保护、清理冗余代码。0.1.0：首个演示版（飞海监控）。海康摄像头参数可在应用内配置（IP/端口/账号/密码/通道/码流），带「测试连接」与编码检测（H.265 引导改 H.264）；文件数与存储目录可设置。
